NOTION_TOKEN=
NOTION_TASK_DS=79601071-9560-41c1-9ad2-a036bd4c2df8
NOTION_CONVERSATION_DS=0fe672f1-49c6-498b-a4c6-d5c5fe6d3fa4
NOTION_CONTACT_DS=e9fce670-c858-4ab2-9d50-fd196b64f8ed
NOTION_KEYPERSON_DS=cd09166f-d9fd-836c-864b-073b80032dce
NOTION_CONVERSATION_DB=a7ded397b23f47f1a9113855fc3d10ce

# SMS Gateway for Android
# mode: local | private | cloud
SMS_GATEWAY_MODE=private
SMS_GATEWAY_URL=https://smsgate.fcconnect.co
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=

# Public URL that phones / gateways call back into
WEBHOOK_BASE=https://orch.fcconnect.co

# Own Saily number (E.164) for Sender field on outbound
SAILY_PHONE_E164=+16208941711
# Gateway simNumber (1-based). Tello +16208941711 is currently simNumber=2
SMS_SIM_NUMBER=2

# Scheduling — Notion Scheduled At (datetime + timezone) is source of truth
TIMEZONE=America/New_York
# Legacy; outbound no longer gates on work windows
WORK_WINDOWS=09:00-12:00,14:00-18:00
SCHEDULER_SCAN_SECONDS=600
SEND_GAP_SECONDS=90
# Legacy daily-plan knobs (plan-today only)
MIN_SEND_INTERVAL_SECONDS=90
DAILY_PLAN_HOUR=8
DAILY_PLAN_MINUTE=30
SCHEDULER_POLL_SECONDS=20

# Portal Reply ingest (POST /api/replies). Token defaults to local-reply-ingest if empty.
REPLY_WEBHOOK_URL=https://followup-portal.fridgechannels.com/api/replies
REPLY_WEBHOOK_TOKEN=local-reply-ingest
# Cold inbound (no Task): POST /api/inbound. Empty → derive from REPLY_WEBHOOK_URL.
INBOUND_WEBHOOK_URL=https://followup-portal.fridgechannels.com/api/inbound

# Follow-up Client domain cache (FC3.0-Follow-up-ClientDB → Client.Domain)
NOTION_FOLLOWUP_CLIENT_DS=9a07646d-190c-4346-9ab6-96c2e40d66a7
CLIENT_DOMAIN_SYNC_SECONDS=3600

# Gmail (server-side Email send + history poll). One Workspace mailbox.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=ella@fridgechannels.com
GMAIL_POLL_SECONDS=30
# Public mailbox domains (comma-separated). Empty = built-in defaults (gmail/outlook/…).
EMAIL_PUBLIC_DOMAINS=
# Colleague / own domains excluded from cold-inbound external address extraction
EMAIL_INTERNAL_DOMAINS=fridgechannels.com
# Same Gmail thread but From domain ≠ outbound recipient: accept and flag unexpectedSender
EMAIL_ALLOW_CROSS_DOMAIN_THREAD_REPLY=true

# WhatsApp Companion API (optional shared secret)
WA_API_TOKEN=
# Optional; /wa/probe* uses this if set, else WA_API_TOKEN. Probe always requires a token.
WA_PROBE_API_TOKEN=
# Optional monitor settings token; falls back to WA_API_TOKEN
MONITOR_TOKEN=
WA_MIN_SEND_INTERVAL_SECONDS=120
# Min seconds between WhatsApp number-probe enqueues (no daily cap)
WA_PROBE_INTERVAL_SECONDS=120
# 0 = disabled (no daily WhatsApp cap)
WA_DAILY_SEND_LIMIT=0
WA_JOB_LEASE_SECONDS=180
DEVICE_HEARTBEAT_STALE_MINUTES=45
OUTBOUND_UNCERTAIN_COOLDOWN_SECONDS=3600

# S3 for inbound WhatsApp media (image/video/audio/file) → Portal mediaUrl
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=wa-inbound
# Email attachment objects: files/{id}.ext
S3_FILE_PREFIX=files
# Optional CDN / public base (else https://{bucket}.s3.{region}.amazonaws.com/{key})
S3_PUBLIC_BASE_URL=
# Email attachment limits (Portal /api/replies + /api/inbound)
EMAIL_ATTACHMENT_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
EMAIL_ATTACHMENT_MAX_BYTES=10485760
EMAIL_ATTACHMENT_MAX_COUNT=5

# MariaDB for SMS Gate private server (docker-compose)
SMSGATE_DB_ROOT_PASSWORD=change-me-root
SMSGATE_DB_PASSWORD=change-me-sms
